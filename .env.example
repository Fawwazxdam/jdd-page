# Base URL API CMS (diisi sesuai lingkungan, contoh: https://api.example.com)
VITE_API_BASE_URL=

# Mode halaman: "landingpage" atau "speakers" (call for speakers)
VITE_APP_TYPE=landingpage

# Tanggal acara untuk countdown (format: YYYY-MM-DD)
VITE_EVENT_DATE=

# URL form pengisian speaker (dipakai saat VITE_APP_TYPE=speakers)
VITE_SPEAKER_FORM_URL=

# URL form media partner
VITE_MEDIA_PARTNER_FORM_URL=
